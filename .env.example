# =========================================================
# GitHub API Configuration for Daily Streak
# =========================================================
# NEVER commit your actual .env file. It is ignored by git.
# 1. Create a fine-grained Personal Access Token:
#    GitHub -> Settings -> Developer settings -> Personal access tokens -> Fine-grained tokens
#    Repository access: Only your daily-streak repository
#    Permissions: Contents -> Read and write
# 2. Fill in the values below:

GITHUB_TOKEN=github_pat_your_personal_access_token
GITHUB_OWNER=your_github_username
GITHUB_REPO=daily-streak
GITHUB_BRANCH=main
